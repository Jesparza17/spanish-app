# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase project settings -> API) — only used by scripts/
# (the content pipeline). Never imported from src/, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API keys — only used by scripts/generate-content.ts
ANTHROPIC_API_KEY=
