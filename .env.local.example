# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase project settings -> API) — free, from your own
# Supabase project. Required to insert content (scripts/insert-content.ts or
# scripts/generate-content.ts). Never imported from src/, never sent to the
# browser.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API keys — OPTIONAL. Only needed if you use
# scripts/generate-content.ts, the standalone automated pipeline that calls
# the Anthropic API directly and is billed separately from any Claude
# subscription. The default workflow (ask Claude Code to generate a batch,
# then run scripts/insert-content.ts) doesn't need this at all.
ANTHROPIC_API_KEY=
